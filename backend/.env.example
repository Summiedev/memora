# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/memora?retryWrites=true&w=majority

# MongoDB Connection Pool (optional)
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=5

# MongoDB Timeouts in ms (optional)
MONGO_SOCKET_TIMEOUT=45000
MONGO_CONNECT_TIMEOUT=10000
MONGO_SERVER_SELECTION_TIMEOUT=5000
MONGO_MAX_IDLE_TIME=30000
MONGO_WAIT_QUEUE_TIMEOUT=5000
MONGO_HEARTBEAT_FREQUENCY=10000

# MongoDB Retry Policy (optional)
MONGO_RETRY_WRITES=true
MONGO_RETRY_READS=true

# MongoDB App Name (optional)
MONGO_APP_NAME=memora-api

# MongoDB Read Preference (optional)
MONGO_READ_PREFERENCE=primary

# MongoDB TLS (optional, auto-enabled for mongodb+srv)
MONGO_TLS=true
MONGO_TLS_ALLOW_INVALID_CERTIFICATES=false
MONGO_TLS_INSECURE=false

# JWT
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Client
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Cookies
COOKIE_DOMAIN=

# Security (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Gmail/App Password)
EMAIL_USER=your_email@gmail.com
APP_PASS=your_app_password
